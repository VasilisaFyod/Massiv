<Page x:Class="Massiv.Views.AdminChartsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1300"
      Title="Аналитика заказов">

    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,5,0" Style="{StaticResource TextBlock}"/>
                <Border  Background="{StaticResource LightPink}" Height="42" Width="150" CornerRadius="20" Margin="0,20,0,21">
                    <DatePicker  Style="{StaticResource CustomDatePickerStyle}" 
                                 SelectedDate="{Binding StartDate}" 
                                 SelectedDateFormat="Short" 
                                 Language="ru-RU"/>
                </Border>

                <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0,5,0" Style="{StaticResource TextBlock}"/>
                <Border  Background="{StaticResource LightPink}" Height="42" Width="150" CornerRadius="20" Margin="0,20,0,21">
                    <DatePicker  Style="{StaticResource CustomDatePickerStyle}" 
                                 SelectedDate="{Binding EndDate}" 
                                 SelectedDateFormat="Short" 
                                 Language="ru-RU"/>
                </Border>

                <!--<TextBlock Text="Тип графика:" VerticalAlignment="Center" Margin="20,0,5,0"  Style="{StaticResource TextBlock}"/>
                <Border Background="{StaticResource LightPink}" Height="42" CornerRadius="20" 
                        VerticalAlignment="Center">
                    <ComboBox
                        ItemsSource="{Binding ChartTypes}" 
                        SelectedItem="{Binding SelectedChartType}" 
                        Style="{StaticResource RoundComboBoxStyle}"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        Width="200"/>
                </Border> -->

                <Button Margin="10,0,10,0" 
                        Content="Обновить" 
                        Command="{Binding LoadChartsCommand}" 
                        Style="{StaticResource Button}"
                        Background="{StaticResource Purple}" 
                        Width="202" Height="50" 
                        Foreground="White"/>

            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Grey}" CornerRadius="10" Padding="50,15" Margin="10,0,10,10" HorizontalAlignment="Center">
            <WrapPanel>
                <Border Background="White" CornerRadius="5" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Всего заказов" Style="{StaticResource TextBlock}"/>
                        <TextBlock Text="{Binding Statistics.TotalOrders}" FontWeight="Bold" Style="{StaticResource TextBlock}"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="5" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Выполнено" Style="{StaticResource TextBlock}"/>
                        <TextBlock Text="{Binding Statistics.CompletedOrders}" 
                                   FontWeight="Bold" 
                                   Style="{StaticResource TextBlock}" 
                                   Foreground="{StaticResource Green}"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="5" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="В работе" Style="{StaticResource TextBlock}"/>
                        <TextBlock Text="{Binding Statistics.ActiveOrders}" 
                                   FontWeight="Bold" 
                                   Foreground="#BCF3FF" 
                                   Style="{StaticResource TextBlock}"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="5" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Просрочено" Style="{StaticResource TextBlock}"/>
                        <TextBlock Text="{Binding Statistics.OverdueOrders}" 
                                   Style="{StaticResource TextBlock}" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource Red}"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="5" Padding="10" Margin="5">
                    <StackPanel>
                        <TextBlock Text="% выполнения в срок" Style="{StaticResource TextBlock}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Statistics.OnTimePercentage}" 
                                       Style="{StaticResource TextBlock}" 
                                       FontWeight="Bold" 
                                       Foreground="{Binding Statistics.OnTimePercentage, Converter={StaticResource PercentageToColorConverter}}"/>
                            <TextBlock Text="%" FontSize="16" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="5" Background="White" CornerRadius="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Распределение заказов по статусам" 
                               FontSize="16" FontWeight="Bold" 
                               Margin="0,0,0,10"/>
                    <lvc:PieChart Series="{Binding StatusSeries}" 
                                  LegendLocation="Right" 
                                  Height="300">
                        <lvc:PieChart.ChartLegend>
                            <lvc:DefaultLegend BulletSize="15" 
                                               Foreground="Black"/>
                        </lvc:PieChart.ChartLegend>
                    </lvc:PieChart>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="5" Background="White" CornerRadius="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Динамика заказов по месяцам" 
                               FontSize="16" FontWeight="Bold" 
                               Margin="0,0,0,10"/>
                    <lvc:CartesianChart Series="{Binding MonthlySeries}" 
                                        LegendLocation="None" 
                                        Height="300"
                                        Hoverable="False">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding MonthlyLabels}" 
                                      Title="Месяц"
                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Количество заказов"
                                      MinValue="0">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>